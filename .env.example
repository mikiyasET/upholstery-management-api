# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yonatan?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# File Uploads & Cloudflare R2
UPLOADS_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="5"
PUBLIC_UPLOADS_BASE_URL="http://localhost:3000/uploads"
R2_PUBLIC_BASE_URL="https://pub-yonatan-car-decor.r2.dev"

# Server Port
PORT="3000"
