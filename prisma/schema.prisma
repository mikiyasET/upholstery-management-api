// =========================================================
// Yonatan Car Decor — Prisma Schema
// Inventory, Two-Tier Storage, Orders, Direct Sales, Access
// =========================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Enums
// ---------------------------------------------------------

enum Unit {
  PCS
  METERS
  LITERS
}

enum StoreType {
  MAIN
  MINI
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  DEVELOPER
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum AdjustmentReason {
  DAMAGE
  LOSS
  CORRECTION
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ---------------------------------------------------------
// People & Access
// ---------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  passwordHash String?
  role         UserRole
  isActive     Boolean   @default(true)
  permissions  Json?
  lastLogin    DateTime?
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Reverse relations (things this user recorded/approved)
  priceHistoryChanges        PriceHistory[]
  storeTransfersApproved     StoreTransfer[]
  stockCounts                StockCount[]
  restocks                   Restock[]
  stockAdjustments           StockAdjustment[]
  ordersCreated              Order[]             @relation("OrderCreatedBy")
  orderPaymentsRecorded      OrderPayment[]
  directSalesCreated         DirectSale[]
  directSalePaymentsRecorded DirectSalePayment[]
  auditLogEntries            AuditLog[]
  assetsCreated              Asset[]             @relation("AssetCreatedBy")
  assetsDeleted              Asset[]             @relation("AssetDeletedBy")
  assetLogsRecorded          AssetLog[]
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  baseSalary  Decimal?
  contactInfo String?
  jobRoles    String[] // e.g. ["Tapestry", "Seat Dismantler", "Mechanic"]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User?
  orderAssignments OrderAssignment[]
  storeTransfers   StoreTransfer[] // as responsible employee
}

// ---------------------------------------------------------
// Core Catalog
// ---------------------------------------------------------

model Material {
  id                   String   @id @default(cuid())
  itemCode             String   @unique
  nameEn               String
  nameAm               String
  imageUrl             String?
  unit                 Unit
  isBulkTracked        Boolean  @default(false)
  lowStockThreshold    Decimal  @db.Decimal(10, 2)
  isStandaloneSellable Boolean  @default(false)
  currentPrice         Decimal? @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  priceHistory                   PriceHistory[]
  brands                         MaterialBrand[]
  materialStocks                 MaterialStock[]
  serviceCategoryUsages          ServiceCategoryMaterialUsage[]
  orderServiceMaterialDeductions OrderServiceMaterialDeduction[]
  orderStandaloneItemLines       OrderStandaloneItemLine[]
  directSaleLines                DirectSaleLine[]
  restocks                       Restock[]
  stockAdjustments               StockAdjustment[]
  storeTransfers                 StoreTransfer[]
  stockCounts                    StockCount[]

  @@index([itemCode])
}

model PriceHistory {
  id            String   @id @default(cuid())
  materialId    String
  material      Material @relation(fields: [materialId], references: [id])
  brandName     String?
  sizeName      String?
  colorName     String?
  typeName      String?
  price         Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now())
  changedById   String
  changedBy     User     @relation(fields: [changedById], references: [id])
}

model MaterialBrand {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Abro", "Flamingo"
  size       String?  // e.g. "Small", "Large", "500ml", "16"
  color      String?  // e.g. "Red", "Black", "Blue"
  type       String?  // e.g. "Premium", "Standard", "Economy"
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  directSaleLines                DirectSaleLine[]
  orderStandaloneItemLines       OrderStandaloneItemLine[]
  orderServiceMaterialDeductions OrderServiceMaterialDeduction[]
  brandStocks                    MaterialBrandStock[]
  restocks                 Restock[]
  storeTransfers           StoreTransfer[]
  stockAdjustments         StockAdjustment[]
  stockCounts              StockCount[]

  @@unique([materialId, name, size, color, type])
  @@index([materialId])
}

model ServiceGroup {
  id       String    @id @default(cuid())
  nameEn   String
  nameAm   String
  services Service[]
}

model Service {
  id             String        @id @default(cuid())
  nameEn         String
  nameAm         String
  description    String?
  imageUrl       String?
  serviceGroupId String?
  serviceGroup   ServiceGroup? @relation(fields: [serviceGroupId], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categories ServiceCategory[]
}

model ServiceCategory {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  nameEn    String // e.g. "Large" / "1.60"
  nameAm    String
  price     Decimal @db.Decimal(10, 2)

  materialUsages    ServiceCategoryMaterialUsage[]
  orderServiceLines OrderServiceLine[]
}

model ServiceCategoryMaterialUsage {
  id                String          @id @default(cuid())
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  materialId        String
  material          Material        @relation(fields: [materialId], references: [id])
  quantityUsed      Decimal         @db.Decimal(10, 2)

  @@unique([serviceCategoryId, materialId])
}

// ---------------------------------------------------------
// Two-Tier Storage: Main Store & Mini Store
// ---------------------------------------------------------

model Store {
  id   String    @id @default(cuid())
  name String
  type StoreType @unique

  materialStocks      MaterialStock[]
  materialBrandStocks MaterialBrandStock[]
  restocks            Restock[]
  stockAdjustments    StockAdjustment[]
  stockCounts         StockCount[]

  transfersFrom StoreTransfer[] @relation("TransferFromStore")
  transfersTo   StoreTransfer[] @relation("TransferToStore")
}

model MaterialStock {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  quantity   Decimal  @default(0) @db.Decimal(10, 2)

  @@unique([materialId, storeId])
}

model MaterialBrandStock {
  id              String        @id @default(cuid())
  materialBrandId String
  materialBrand   MaterialBrand @relation(fields: [materialBrandId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  quantity        Decimal       @default(0) @db.Decimal(10, 2)

  @@unique([materialBrandId, storeId])
  @@index([materialBrandId])
  @@index([storeId])
}

model StoreTransfer {
  id                    String         @id @default(cuid())
  materialId            String
  material              Material       @relation(fields: [materialId], references: [id])
  materialBrandId       String?
  materialBrand         MaterialBrand? @relation(fields: [materialBrandId], references: [id], onDelete: SetNull)
  brandName             String?
  sizeName              String?
  colorName             String?
  typeName              String?
  fromStoreId           String
  fromStore             Store          @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStoreId             String
  toStore               Store          @relation("TransferToStore", fields: [toStoreId], references: [id])
  quantityTransferred   Decimal        @db.Decimal(10, 2)
  approvedById          String
  approvedBy            User           @relation(fields: [approvedById], references: [id])
  responsibleEmployeeId String?
  responsibleEmployee   Employee?      @relation(fields: [responsibleEmployeeId], references: [id])
  transferDate          DateTime       @default(now())
  notes                 String?

  @@index([materialBrandId])
}

model StockCount {
  id                    String         @id @default(cuid())
  storeId               String
  store                 Store          @relation(fields: [storeId], references: [id])
  materialId            String
  material              Material       @relation(fields: [materialId], references: [id])
  materialBrandId       String?
  materialBrand         MaterialBrand? @relation(fields: [materialBrandId], references: [id], onDelete: SetNull)
  brandName             String?
  sizeName              String?
  colorName             String?
  typeName              String?
  countedQuantity       Decimal        @db.Decimal(10, 2)
  systemQuantityAtCount Decimal        @db.Decimal(10, 2)
  discrepancy           Decimal        @db.Decimal(10, 2)
  countedById           String
  countedBy             User           @relation(fields: [countedById], references: [id])
  countedAt             DateTime       @default(now())
  notes                 String?

  @@index([materialBrandId])
}

model Restock {
  id              String         @id @default(cuid())
  materialId      String
  material        Material       @relation(fields: [materialId], references: [id])
  materialBrandId String?
  materialBrand   MaterialBrand? @relation(fields: [materialBrandId], references: [id], onDelete: SetNull)
  brandName       String?
  sizeName        String?
  colorName       String?
  typeName        String?
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  quantityAdded   Decimal        @db.Decimal(10, 2)
  unitCost        Decimal?       @db.Decimal(10, 2)
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseDate    DateTime       @default(now())
  recordedById    String
  recordedBy      User           @relation(fields: [recordedById], references: [id])

  @@index([materialBrandId])
}

model StockAdjustment {
  id              String           @id @default(cuid())
  materialId      String
  material        Material         @relation(fields: [materialId], references: [id])
  materialBrandId String?
  materialBrand   MaterialBrand?   @relation(fields: [materialBrandId], references: [id], onDelete: SetNull)
  brandName       String?
  sizeName        String?
  colorName       String?
  typeName        String?
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id])
  quantityDelta   Decimal          @db.Decimal(10, 2) // positive or negative
  reason          AdjustmentReason
  notes           String?
  adjustedById    String
  adjustedBy      User             @relation(fields: [adjustedById], references: [id])
  adjustedAt      DateTime         @default(now())

  @@index([materialBrandId])
}

model Supplier {
  id       String    @id @default(cuid())
  name     String
  phone    String?
  notes    String?
  restocks Restock[]
}

// ---------------------------------------------------------
// Vehicle-Related Entities
// ---------------------------------------------------------

model CarBrand {
  id      String     @id @default(cuid())
  name    String
  logoUrl String?
  models  CarModel[]
}

model CarModel {
  id       String   @id @default(cuid())
  brandId  String
  brand    CarBrand @relation(fields: [brandId], references: [id])
  name     String
  imageUrl String?

  vehicles Vehicle[]
}

model Vehicle {
  id          String   @id @default(cuid())
  carModelId  String
  carModel    CarModel @relation(fields: [carModelId], references: [id])
  plateNumber String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@unique([plateNumber])
}

model CarStatus {
  id          String  @id @default(cuid())
  code        String? @unique
  name        String
  description String?

  orderCarStatuses OrderCarStatus[]
}

model OrderCarStatus {
  id                String     @id @default(cuid())
  orderId           String
  order             Order      @relation(fields: [orderId], references: [id])
  carStatusId       String?
  carStatus         CarStatus? @relation(fields: [carStatusId], references: [id])
  customName        String? // used when carStatusId is null ("Other")
  customDescription String?
}

// ---------------------------------------------------------
// Customer
// ---------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  name        String
  phoneNumber String   @unique
  createdAt   DateTime @default(now())

  vehicles Vehicle[]
  orders   Order[]
}

// ---------------------------------------------------------
// Orders
// ---------------------------------------------------------

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  fsrNumber      String?
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  orderDateTime  DateTime      @default(now())
  orderStatus    OrderStatus   @default(OPEN)
  paymentStatus         PaymentStatus @default(UNPAID)
  discountAmount        Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount             Decimal       @default(0) @db.Decimal(10, 2)
  downPayment           Decimal       @default(0) @db.Decimal(10, 2)
  serviceFee            Decimal       @default(0) @db.Decimal(10, 2)
  deadline              DateTime?
  deadlineWarningSent   Boolean       @default(false)
  deadlineWarningSentAt DateTime?
  notes                 String?
  createdById           String
  createdBy             User          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  carStatuses       OrderCarStatus[]
  assignments       OrderAssignment[]
  serviceLines      OrderServiceLine[]
  standaloneLines   OrderStandaloneItemLine[]
  additionalCharges OrderAdditionalCharge[]
  payments          OrderPayment[]

  @@index([fsrNumber])
  @@index([deadline])
  @@index([deadlineWarningSent])
}

model OrderAssignment {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  roleLabel  String // e.g. "Seat Dismantler", "Tapestry"
  assignedAt DateTime @default(now())
}

model OrderServiceLine {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  priceAtOrderTime  Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())

  materialDeductions OrderServiceMaterialDeduction[]
}

model OrderServiceMaterialDeduction {
  id                   String           @id @default(cuid())
  orderServiceLineId   String
  orderServiceLine     OrderServiceLine @relation(fields: [orderServiceLineId], references: [id], onDelete: Cascade)
  materialId           String
  material             Material         @relation(fields: [materialId], references: [id])
  materialBrandId      String?
  materialBrand        MaterialBrand?   @relation(fields: [materialBrandId], references: [id], onDelete: SetNull)
  brandName            String?
  sizeName             String?
  colorName            String?
  typeName             String?
  quantityDeducted     Decimal          @db.Decimal(10, 2)
  unitPriceAtOrderTime Decimal?         @db.Decimal(10, 2)

  @@index([materialBrandId])
}

model OrderStandaloneItemLine {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  materialId       String
  material         Material       @relation(fields: [materialId], references: [id])
  materialBrandId  String?
  materialBrand    MaterialBrand? @relation(fields: [materialBrandId], references: [id], onDelete: SetNull)
  brandName        String?
  sizeName         String?
  colorName        String?
  typeName         String?
  quantity         Decimal        @db.Decimal(10, 2)
  priceAtOrderTime Decimal        @db.Decimal(10, 2)
}

model OrderAdditionalCharge {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  name        String
  price       Decimal @db.Decimal(10, 2)
  description String?
}

model OrderPayment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  methodDetails String?
  paidAt        DateTime      @default(now())
  recordedById  String
  recordedBy    User          @relation(fields: [recordedById], references: [id])
}

// ---------------------------------------------------------
// Direct Sales (walk-in purchases, no vehicle/order)
// ---------------------------------------------------------

model DirectSale {
  id             String        @id @default(cuid())
  saleNumber     String        @unique
  fsrNumber      String?
  saleDateTime   DateTime      @default(now())
  customerName   String?
  customerPhone  String?
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  lines    DirectSaleLine[]
  payments DirectSalePayment[]

  @@index([fsrNumber])
}

model DirectSaleLine {
  id              String         @id @default(cuid())
  directSaleId    String
  directSale      DirectSale     @relation(fields: [directSaleId], references: [id])
  materialId      String
  material        Material       @relation(fields: [materialId], references: [id])
  materialBrandId String?
  materialBrand   MaterialBrand? @relation(fields: [materialBrandId], references: [id], onDelete: SetNull)
  brandName       String?
  sizeName        String?
  colorName       String?
  typeName        String?
  quantity        Decimal        @db.Decimal(10, 2)
  priceAtSaleTime Decimal        @db.Decimal(10, 2)
}

model DirectSalePayment {
  id            String        @id @default(cuid())
  directSaleId  String
  directSale    DirectSale    @relation(fields: [directSaleId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  methodDetails String?
  paidAt        DateTime      @default(now())
  recordedById  String
  recordedBy    User          @relation(fields: [recordedById], references: [id])
}

// ---------------------------------------------------------
// Audit Log
// ---------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  entityType  String // e.g. "Material", "Order", "StoreTransfer"
  entityId    String
  action      AuditAction
  changedById String
  changedBy   User        @relation(fields: [changedById], references: [id])
  oldValue    Json?
  newValue    Json?
  timestamp   DateTime    @default(now())
}

// ---------------------------------------------------------
// Daily Pre-aggregated Analytics & Revenue Statistics
// ---------------------------------------------------------

model DailyStats {
  id                String   @id @default(cuid())
  date              String   @unique // format: YYYY-MM-DD
  totalRevenue      Decimal  @default(0) @db.Decimal(12, 2)
  orderRevenue      Decimal  @default(0) @db.Decimal(12, 2)
  directSaleRevenue Decimal  @default(0) @db.Decimal(12, 2)
  orderCount        Int      @default(0)
  directSaleCount   Int      @default(0)
  totalOrders       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([date])
}

// ---------------------------------------------------------
// Company Assets & Tools
// ---------------------------------------------------------

model Asset {
  id               String     @id @default(cuid())
  assetTag         String?    @unique
  nameEn           String
  nameAm           String
  description      String?
  imageUrl         String?
  quantity         Decimal    @default(1) @db.Decimal(10, 2)
  unit             String     @default("PCS")
  category         String?
  location         String?
  isDeleted        Boolean    @default(false)
  deletedAt        DateTime?
  scheduledPurgeAt DateTime?
  createdById      String?
  createdBy        User?      @relation("AssetCreatedBy", fields: [createdById], references: [id])
  deletedById      String?
  deletedBy        User?      @relation("AssetDeletedBy", fields: [deletedById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  logs AssetLog[]

  @@index([isDeleted])
  @@index([scheduledPurgeAt])
  @@index([category])
}

model AssetLog {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      String   // "CREATE" | "UPDATE" | "TRASH" | "RESTORE"
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changes     Json?    // Detailed diff: { quantity: { old: 5, new: 3 }, ... }
  notes       String?  // Optional audit note / reason
  createdAt   DateTime @default(now())

  @@index([assetId])
  @@index([changedById])
  @@index([createdAt])
}


